# Server-only. Never prefix with NEXT_PUBLIC_ or import into client components.
# Project URL: Dashboard → Project Settings → API → Project URL
SUPABASE_URL=

# Secret key (starts with sb_secret_...). Dashboard → Project Settings → API Keys
# → Secret keys → copy the "default" key (or create one named default).
# Do NOT use the publishable key (sb_publishable_...) or any legacy anon JWT here.
# This bypasses RLS and must stay server-only.
SUPABASE_SECRET_KEY=

# Shared secret for n8n -> POST /api/blog/ingest and GET /api/blog/list
BLOG_INGEST_TOKEN=

# Optional shared secret for manual on-demand revalidation helpers
REVALIDATE_SECRET=
